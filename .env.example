# ==============================================================================
# Mini Project 01: E-Commerce Data Engineering Pipeline
# Environment Variables & Local Development Configuration Defaults
# ==============================================================================

# Project Name
COMPOSE_PROJECT_NAME=ecommerce_pipeline

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Airflow Metadata DB Configuration
AIRFLOW_DB=airflow
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_FIRSTNAME=Airflow
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_SECRET_KEY=4686e72d99d79f4c176decab36ac72f3
AIRFLOW_WEBSERVER_PORT=8080

# MongoDB Configuration (Raw Orders Document Store)
MONGO_USER=mongoadmin
MONGO_PASSWORD=mongopassword
MONGO_DB=ecommerce
MONGO_RAW_COLLECTION=raw_orders
MONGO_PORT=27017
MONGO_HOST=mongodb

# RabbitMQ Configuration (Message Broker)
RABBITMQ_USER=ecommerce_app
RABBITMQ_PASSWORD=YOUR_GENERATED_PASSWORD
RABBITMQ_QUEUE=ecommerce_orders
RABBITMQ_EXCHANGE=orders_exchange
RABBITMQ_ROUTING_KEY=order.created
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_HOST=rabbitmq
GENERATOR_RABBITMQ_HOST=localhost

# Elasticsearch Configuration (Search & Analytics)
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX=ecommerce_orders

# Apache NiFi Configuration (ETL & Routing Engine)
NIFI_ADMIN_USER=admin
NIFI_ADMIN_PASSWORD=AdminPassword123!
NIFI_HTTPS_PORT=8443
NIFI_HOST=nifi

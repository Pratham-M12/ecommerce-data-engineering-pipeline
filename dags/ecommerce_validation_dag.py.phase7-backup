from datetime import datetime
import json
import logging
import os
from pathlib import Path
import subprocess
import sys

from deltalake import DeltaTable
import psycopg2
from airflow import DAG
from airflow.operators.python import PythonOperator


EXPECTED_TABLES = {"customers", "orders", "order_items"}
EXPECTED_DELTA_COUNTS = {
    "customers": 12,
    "orders": 12,
    "order_items": 34,
    "daily_sales": 1,
    "category_sales": 4,
}

TRANSFORM_SCRIPT = Path("/opt/airflow/src/transform/phase6_transform.py")
DELTA_DIR = Path("/opt/airflow/data/phase6/delta")
REPORT_PATH = Path("/opt/airflow/reports/phase6_validation.json")


def get_connection():
    required = [
        "POSTGRES_HOST",
        "POSTGRES_PORT",
        "POSTGRES_DB",
        "POSTGRES_USER",
        "POSTGRES_PASSWORD",
    ]
    missing = [name for name in required if not os.getenv(name)]
    if missing:
        raise RuntimeError(
            "Missing PostgreSQL environment variables: " + ", ".join(missing)
        )

    return psycopg2.connect(
        host=os.environ["POSTGRES_HOST"],
        port=int(os.environ["POSTGRES_PORT"]),
        dbname=os.environ["POSTGRES_DB"],
        user=os.environ["POSTGRES_USER"],
        password=os.environ["POSTGRES_PASSWORD"],
        connect_timeout=10,
    )


def check_postgres_connection():
    with get_connection() as conn:
        with conn.cursor() as cursor:
            cursor.execute("SELECT current_database(), current_user")
            database, user = cursor.fetchone()

            cursor.execute(
                """
                SELECT table_name
                FROM information_schema.tables
                WHERE table_schema = 'public'
                  AND table_name IN ('customers', 'orders', 'order_items')
                """
            )
            found = {row[0] for row in cursor.fetchall()}

    missing = EXPECTED_TABLES - found
    if missing:
        raise RuntimeError(
            "Expected PostgreSQL tables are missing: "
            + ", ".join(sorted(missing))
        )

    logging.info(
        "PostgreSQL connection successful. Database=%s, user=%s, tables=%s",
        database,
        user,
        ", ".join(sorted(found)),
    )


def validate_table_counts():
    counts = {}

    with get_connection() as conn:
        with conn.cursor() as cursor:
            for table in sorted(EXPECTED_TABLES):
                cursor.execute(f'SELECT COUNT(*) FROM public."{table}"')
                counts[table] = cursor.fetchone()[0]

    for table, count in counts.items():
        logging.info("Table %s: %s rows", table, count)

    empty_tables = [table for table, count in counts.items() if count == 0]
    if empty_tables:
        raise RuntimeError(
            "Expected non-empty tables, but these are empty: "
            + ", ".join(empty_tables)
        )

    logging.info("PostgreSQL validation passed.")


def run_phase6_transform():
    if not TRANSFORM_SCRIPT.is_file():
        raise FileNotFoundError(
            f"Phase 6 transformation script not found: {TRANSFORM_SCRIPT}"
        )

    result = subprocess.run(
        [sys.executable, str(TRANSFORM_SCRIPT)],
        check=False,
        capture_output=True,
        text=True,
        timeout=600,
    )

    if result.stdout:
        logging.info("Phase 6 stdout:\n%s", result.stdout)
    if result.stderr:
        logging.info("Phase 6 stderr:\n%s", result.stderr)

    if result.returncode != 0:
        raise RuntimeError(
            f"Phase 6 transformation failed with exit code {result.returncode}"
        )

    logging.info("Phase 6 transformation process completed successfully.")


def verify_phase6_outputs():
    if not REPORT_PATH.is_file():
        raise FileNotFoundError(f"Phase 6 report not found: {REPORT_PATH}")

    report = json.loads(REPORT_PATH.read_text(encoding="utf-8"))

    if report.get("status") != "success":
        raise RuntimeError("Phase 6 report does not show success.")

    if report.get("order_total_mismatches") != 0:
        raise RuntimeError("Phase 6 report contains order-total mismatches.")

    reported_tables = report.get("delta_tables", {})
    if set(reported_tables) != set(EXPECTED_DELTA_COUNTS):
        raise RuntimeError("Phase 6 report does not list exactly the expected Delta tables.")

    for table_name, expected_count in EXPECTED_DELTA_COUNTS.items():
        table_path = DELTA_DIR / table_name
        if not table_path.is_dir():
            raise FileNotFoundError(f"Delta table directory not found: {table_path}")

        actual_count = DeltaTable(str(table_path)).to_pyarrow_table().num_rows
        reported_count = reported_tables[table_name].get("rows")

        logging.info(
            "Delta table %s: expected=%s, actual=%s, report=%s",
            table_name,
            expected_count,
            actual_count,
            reported_count,
        )

        if actual_count != expected_count or reported_count != expected_count:
            raise RuntimeError(
                f"Delta table {table_name} row-count validation failed."
            )

    logging.info("Phase 6 output verification passed.")


with DAG(
    dag_id="ecommerce_validation_dag",
    description="Validate PostgreSQL, run transformations, and verify Delta outputs",
    start_date=datetime(2026, 1, 1),
    schedule_interval=None,
    catchup=False,
    tags=["ecommerce", "validation", "transformation"],
) as dag:
    connection_check = PythonOperator(
        task_id="check_postgres_connection",
        python_callable=check_postgres_connection,
    )

    counts_check = PythonOperator(
        task_id="validate_table_counts",
        python_callable=validate_table_counts,
    )

    transform = PythonOperator(
        task_id="run_phase6_transform",
        python_callable=run_phase6_transform,
    )

    output_check = PythonOperator(
        task_id="verify_phase6_outputs",
        python_callable=verify_phase6_outputs,
    )

    connection_check >> counts_check >> transform >> output_check
